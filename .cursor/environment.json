{
  "name": "QuantumTrade Pro",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": ". .venv/bin/activate && PYTHONPATH=. uvicorn backend.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && BACKEND_URL=http://localhost:8000 FRONTEND_PORT=5173 npm run dev"
    }
  ],
  "ports": [
    { "name": "backend", "port": 8000 },
    { "name": "frontend", "port": 5173 }
  ]
}
