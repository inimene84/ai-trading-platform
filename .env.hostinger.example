# Hostinger hPanel / Node.js builder environment — KEEP UNDER 8192 CHARACTERS.
# Paste THIS file (or .env.hostinger), never the VPS QuantumTrade .env.
#
# Live trading stays on Hostinger VPS srv1071801 Docker:
#   /root/ai-trading-platform-v3/.env
# Do not put exchange keys, ADMIN_API_KEY, CTRADER tokens, PEMs, JWTs,
# LiteLLM/Jesse/OpenSearch blobs, or DATABASE_URL into this panel.
# JESSE_SYNC_TO_LIVE stays false on the VPS. This file does not set it.

NODE_ENV=production
VITE_API_URL=/api/backend
VITE_BACKEND_URL=/api/backend
VITE_WS_URL=wss://YOUR_DOMAIN/api/backend
VITE_APP_NAME=QuantumTrade Pro
VITE_APP_VERSION=3.0.0
VITE_BINANCE_DIRECT_WS=false
