      {
        "parameters": {
          "jsCode": "// Detect sentiment-price divergence from GET /technical `output` (or a raw row).\nfunction rowsFrom(item) {\n  if (Array.isArray(item.output)) return item.output;\n  if (Array.isArray(item.data)) return item.data.map((r) => ({ json: r }));\n  if (item.json && item.json.symbol) return [item];\n  if (item.symbol) return [{ json: item }];\n  return [];\n}\n\nconst incoming = $input.all().map((i) => i.json);\nconst rows = incoming.flatMap(rowsFrom);\nconst results = [];\n\nfor (const wrapped of rows) {\n  const row = wrapped.json || wrapped;\n  const symbol = row.symbol;\n  const sentiment_score = Number(row.sentiment_score || 0);\n  const direction = String(row.direction || 'NEUTRAL').toUpperCase();\n  const price_change_pct = Number(row.price_change_pct || 0);\n\n  let signal = 'NEUTRAL';\n  let confidence = 0.0;\n  if (direction === 'BULLISH' && price_change_pct < 0) {\n    signal = 'SELL_DUE_TO_SENTIMENT';\n    confidence = Math.abs(price_change_pct);\n  } else if (direction === 'BEARISH' && price_change_pct > 0) {\n    signal = 'BUY_DUE_TO_SENTIMENT';\n    confidence = price_change_pct;\n  }\n\n  if (signal !== 'NEUTRAL' && Math.abs(price_change_pct) >= 0.02) {\n    results.push({\n      json: {\n        symbol,\n        sentiment_score,\n        direction,\n        price_change: price_change_pct,\n        signal,\n        confidence,\n        reasoning: `Sentiment ${direction.toLowerCase()} but price ${price_change_pct >= 0 ? 'rising' : 'falling'} by ${(Math.abs(price_change_pct) * 100).toFixed(2)}%`,\n        source: 'n8n-divergence',\n      },\n    });\n  }\n}\n\nreturn results;\n"
        },
