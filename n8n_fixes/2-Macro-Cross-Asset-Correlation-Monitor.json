      {
        "parameters": {
          "jsCode": "// Calculate correlations and macro regime (Yahoo Finance fan-in)\nfunction priceFrom(nodeName) {\n  try {\n    const j = $(nodeName).first()?.json;\n    return j?.chart?.result?.[0]?.meta?.regularMarketPrice || 0;\n  } catch (e) {\n    return 0;\n  }\n}\n\nconst assets = {\n  BTC: priceFrom('Fetch BTC Price'),\n  SP500: priceFrom('Fetch S&P500 Price'),\n  GOLD: priceFrom('Fetch Gold Price'),\n  DXY: priceFrom('Fetch DXY (Dollar Index)'),\n  VIX: priceFrom('Fetch VIX'),\n};\n\nlet riskRegime = 'NEUTRAL';\nif (assets.VIX > 25) {\n  riskRegime = 'RISK_OFF';\n} else if (assets.VIX > 0 && assets.VIX < 15) {\n  riskRegime = 'RISK_ON';\n}\n\nlet dollarImpact = 'NEUTRAL';\nif (assets.DXY > 105) {\n  dollarImpact = 'STRONG_DOLLAR_BEARISH_FOR_BTC';\n} else if (assets.DXY > 0 && assets.DXY < 95) {\n  dollarImpact = 'WEAK_DOLLAR_BULLISH_FOR_BTC';\n}\n\nconst goldBtcRatio = assets.GOLD > 0 && assets.BTC > 0 ? assets.GOLD / assets.BTC : 0;\n\nreturn [{\n  json: {\n    id: `macro_${Date.now()}`,\n    source: 'macro-correlation',\n    btc_price: Number(assets.BTC.toFixed(2)),\n    sp500_price: Number(assets.SP500.toFixed(2)),\n    gold_price: Number(assets.GOLD.toFixed(2)),\n    dxy: Number(assets.DXY.toFixed(2)),\n    vix: Number(assets.VIX.toFixed(2)),\n    risk_regime: riskRegime,\n    dollar_impact: dollarImpact,\n    gold_btc_ratio: Number(goldBtcRatio.toFixed(6)),\n    correlation_btc_sp500: 0,\n    correlation_btc_gold: 0,\n    correlation_btc_dxy: 0,\n    published_at: Math.floor(Date.now() / 1000),\n    time_horizon: 'short',\n    topics: 'macro,correlation,risk-regime',\n  },\n}];\n"
        },
        "id": "a62ba70c-d3cf-497f-a866-44d1bc6f1b3a",
