# /docker/n8n/.env — keep this file mode 600 and out of git.
# DO NOT RUN this stack on the live trading host.
# COMPOSE_FILE makes `docker compose up` include the sandbox overlay.
#
# RISK: N8N_BLOCK_ENV_ACCESS_IN_NODE=false (set in docker-compose.yml) lets
# Code nodes read process env, including BACKEND_API_KEY. Leave it false so
# existing workflows keep working; do not "fix" that by deploying n8n next
# to the live trading containers.

COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml

# Existing QuantumTrade HTTP nodes
BACKEND_API_KEY=

# Sandbox service secrets — generate unique values, never leave change-me
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=

# Must match SANDBOX_API_KEYS — how n8n authenticates to sandbox-api
N8N_SANDBOX_SERVICE_API_KEY=

# Existing internal SearXNG on trading-net (JSON already enabled)
N8N_INSTANCE_AI_SEARXNG_URL=http://ai-trading-searxng:8080

# Leave model name unset so Settings → AI Assistant can save it.
# Setting N8N_INSTANCE_AI_MODEL locks the UI ("environment-managed fields: modelName").
# Optional env-only fallback (do not combine with the UI model field):
# N8N_INSTANCE_AI_MODEL=anthropic/claude-opus-4-8
# N8N_INSTANCE_AI_MODEL_API_KEY=
