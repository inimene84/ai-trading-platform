# ──────────────────────────────────────────────────────────────────────────────
# AI HEDGE FUND — COMPLETE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# ── AI Brain (LLM Engine) ───────────────────────────────────────────────────

# PRIMARY: OmniRoute (https://omni.allikas.online) — auto-selects best/free model
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_BASE_URL=https://omni.allikas.online/v1
OMNIROUTE_DEFAULT_MODEL=auto/fast
PERSONA_LLM_MODEL=auto/fast
GENERAL_LLM_MODEL=auto/fast
# OmniRoute auto/fast is ~7–8s on Allikas; QT VPS may add RTT. Do NOT set a
# global 8s timeout — it clips healthy OmniRoute calls. Per-provider:
LLM_OMNIROUTE_TIMEOUT_SECONDS=25
LLM_KIE_TIMEOUT_SECONDS=10
LLM_CHAIN_BUDGET_SECONDS=55
LLM_PERSONA_CHAIN_BUDGET_SECONDS=48
LLM_RETRY_BACKOFF_SECONDS=0.35
PERSONA_ENRICHMENT_TIMEOUT_SECONDS=70

# ALTERNATIVE / FALLBACK: xAI (Grok)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4-1-fast-reasoning
OLLAMA_ENABLED=false
XAI_BASE_URL=https://api.x.ai/v1

# ALTERNATIVE: Kie.ai (Direct). Families use different host paths (docs.kie.ai):
#   gpt-5-6-* / gpt-5-5  → POST /codex/v1/responses
#   gpt-5-*-codex        → POST /api/v1/responses
#   claude-*             → POST /claude/v1/messages          (stream:false)
#   gemini-*             → POST /{slug}/v1/chat/completions  (stream:false)
#   grok-*               → POST /grok/v1/responses
#   gpt-5-2              → POST /gpt-5-2/v1/chat/completions
KIE_API_KEY=your_kie_api_key_here
KIE_MODEL=gpt-5-6-luna
KIE_FALLBACK_MODELS=gemini-3-8-flash-openai,claude-haiku-4-5
KIE_OPUS_MODEL=
KIE_BASE_URL=https://api.kie.ai

# Fallback chain (router still prefers OmniRoute auto/* even if these are set)
PERSONA_LLM_PROVIDER=omniroute
DEEP_ANALYSIS_LLM_PROVIDER=omniroute
GENERAL_LLM_PROVIDER=omniroute

LITELLM_API_KEY=

# FALLBACK: Anthropic
# Used if neither xAI nor Kie keys are set.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LOCAL: LiteRT-LM (On-device)
# Set path to a .litertlm model (e.g. Gemma 2B) to run entirely offline.
# Leave EMPTY to use cloud brains.
LITERT_MODEL_PATH=
LITERT_MAX_TOKENS=4096

# CLOUD ALTERNATIVES: OpenAI / Groq / Google
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here


# ── Market Data Providers (Free Tier) ────────────────────────────────────────

# Binance (Public API — no key needed for crypto data)
# yfinance (Public API — no key needed for stocks/forex/commodities)

# CoinGecko (Free key — 30/min limit)
COINGECKO_API_KEY=

# CoinMarketCap (Free key — 30/min limit)
COINMARKETCAP_API_KEY=

# Alpha Vantage (Free key — 25/day limit)
ALPHAVANTAGE_API_KEY=

# Twelve Data (Free key — 8/min limit)
TWELVEDATA_API_KEY=

# Polygon.io (Free key — 5/min limit)
POLYGON_API_KEY=

# FRED (Macro data: Fed rates, CPI, GDP — Free key)
FRED_API_KEY=

# NewsAPI (News headlines — Free key)
NEWSAPI_KEY=

# CryptoCompare (Crypto news — Free key)
CRYPTOCOMPARE_API_KEY=

# ── Native Loops ─────────────────────────────────────────────────────────────
MACRO_LOOP_ENABLED=true
MACRO_LOOP_INTERVAL_MIN=60
GRAFANA_URL=http://127.0.0.1:8081/grafana

# OPENROUTER (Embeddings + optional chat fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter embedding model (1536d for Qdrant crypto-news)
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMENSIONS=1536

# Native loops — market alert Telegram digest
MARKET_ALERTS_ENABLED=true
MARKET_ALERTS_INTERVAL_MINUTES=120
# Opinion layer query window — should exceed interval (default: interval + 30)
MARKET_ALERTS_LOOKBACK_MINUTES=150

# ── Unified Feed + Cron Scheduler ─────────────────────────────────────────────
# Multi-asset quote universe (comma-separated). Crypto defaults to
# TRADING_SYMBOLS when FEED_SYMBOLS_CRYPTO is unset.
# FEED_SYMBOLS_CRYPTO=BTCUSDC,ETHUSDC,SOLUSDC,BNBUSDC,XRPUSDC
# FEED_SYMBOLS_EQUITIES=AAPL,MSFT,NVDA,SPX
# FEED_SYMBOLS_METALS=XAUUSD,XAGUSD,XPTUSD,XPDUSD
# FEED_SYMBOLS_FOREX=EURUSD,GBPUSD,USDJPY,EURJPY,AUDUSD,USDCAD,USDCHF,NZDUSD

# Cron scheduler (standard 5-field cron, UTC) for feed refresh / dashboard
# snapshots / Kronos batch forecasts. Master switch plus per-job overrides.
FEED_SCHEDULER_ENABLED=true
FEED_REFRESH_CRON="*/5 * * * *"
DASHBOARD_SNAPSHOT_CRON="*/15 * * * *"
KRONOS_BATCH_CRON="*/30 * * * *"
# Per-job enable overrides (default true)
# FEED_REFRESH_ENABLED=true
# DASHBOARD_SNAPSHOT_ENABLED=true
# KRONOS_BATCH_ENABLED=true


# LunarCrush (Social sentiment — Free key)
LUNARCRUSH_API_KEY=

# Reddit API (PRAW — Free key)
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=hedge-fund-bot/1.0


# ── Execution Brokers ─────────────────────────────────────────────────────────

# GLOBAL OVERRIDE: If true, NO real orders will ever be sent (Safe mode)
DRY_RUN_ALL=true

# Crypto loop execution. TRADING_MODE=paper uses the local PaperTradingEngine
# (simulated fills, IDs like paper_000001). It does NOT place Binance orders
# and does NOT use Futures Testnet or Spot testnet.
# Futures Testnet is a separate path: TRADING_MODE=live BINANCE_TESTNET=true
# plus demo/testnet API keys (python-binance → testnet.binancefuture.com).
# Do not point live keys at testnet, and do not invent demo keys.
TRADING_MODE=paper
PAPER_TRADING=true
PAPER_BALANCE=100000
# Run a local Binance paper book beside live/demo cTrader. Does NOT place
# Binance exchange orders. Ignored when TRADING_MODE=paper (already paper).
# BINANCE_PAPER_PARALLEL=true

# 1. cTrader (Forex / CFD via IC Markets, Pepperstone, etc.)
# Run scripts/get_token.py to generate these
CTRADER_ENV=demo
# Use sandbox for Spotware portal apps with Sandbox credentials (MyTradingBotEst etc.)
# Values: sandbox | demo | live
# Do NOT set live without Toomas money confirmation. This file never auto-switches.
ACTIVE_BROKER=ctrader
# Kill/drawdown equity: broker (default) = one book. union = same money-mode books
# only. Demo cTrader + live Binance is always split_book and never unioned.
EQUITY_RISK_SCOPE=broker
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
# Must match a redirect URL registered in your Spotware Open API app settings
CTRADER_REDIRECT_URI=https://localhost/callback
# Paper mode defaults to demo host; set CTRADER_PAPER_MODE=false + CTRADER_LIVE_CONFIRM=I_UNDERSTAND for live
CTRADER_PAPER_MODE=true
CTRADER_LIVE_CONFIRM=
# Concurrent demo forex execution (Open API → IC Markets)
CTRADER_FOREX_ONLY=false
CTRADER_MAX_OPEN_POSITIONS=10
CTRADER_MAX_READY_PER_POLL=10
CTRADER_MAX_LOTS=0.10
CTRADER_ONE_POSITION_PER_SYMBOL=true
CTRADER_INCLUDE_METALS=true
CTRADER_MAX_SAME_BASE=2
CTRADER_MAX_METAL_LOTS=0.01
CTRADER_MAX_CANDIDATES=200
# AI Pre-Execution Gate: enforce (veto bad trades), shadow (log only), off (disabled)
FX_KRONOS_GATE=enforce
# Minimum ADX to allow MOMENTUM_TREND_PULSE breakouts (avoids ranging chop)
MOMENTUM_MIN_ADX=22
# Lockout minutes on a symbol after a stop-out to prevent serial whipsaw losses
SYMBOL_COOLDOWN_MINUTES=45
# Used only when live cTrader credentials exist but equity is not yet synced
CTRADER_FALLBACK_EQUITY=150
# Connect cTrader Open API on backend startup (required for n8n execute-candidate)
CTRADER_AUTO_CONNECT=true
# Protection sizing. Stops come from SIGNAL_STOP_TIMEFRAME rather than the
# entry timeframe; CTRADER_MIN_STOP_PIPS is the backstop for anything still
# inside the broker stop level, which the broker would otherwise discard.
SIGNAL_STOP_TIMEFRAME=H1
CTRADER_MIN_STOP_PIPS=10
# JPY crosses need a wider broker stop level than majors (10 pips is dropped)
CTRADER_MIN_JPY_STOP_PIPS=30

# 2. Binance (Crypto Spot)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# Reduce signed REST polling on VPS to avoid IP bans (default 60s; use 180 on live VPS)
BINANCE_WALLET_POLL_INTERVAL=180
BINANCE_ORDER_POLL_INTERVAL=180
# 20-symbol scan: 4 batches of 5, 3s pause, 2 concurrent per batch (~2400 weight/min budget)
SYMBOL_BATCH_SIZE=5
SYMBOL_BATCH_PAUSE_SEC=3
SYMBOL_CONCURRENCY=2
TICKER_CACHE_TTL_SEC=15

# 3. CCXT (Universal: Kraken, Bybit, OKX, KuCoin, etc.)
# Replace KRAKEN with your exchange name (e.g. BYBIT_API_KEY)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_SANDBOX=true

# 4. Alpaca (Stocks, ETFs, Crypto)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# 5. OANDA (Forex)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true


# ── Risk Management ──────────────────────────────────────────────────────────

# Core settings
RISK_PER_TRADE=0.01          # Risk 1% of equity per trade
MAX_POSITIONS=5              # Hard cap on total open trades
MIN_SIGNAL_STRENGTH=0.55     # Combined agent confidence threshold (0.0-1.0)
MIN_RISK_REWARD=1.5          # Minimum target RR ratio (e.g. 1:1.5)

# News sentiment as a Decision Engine entry gate. Default OFF: n8n + native
# sentiment_loop feed Grafana / opinion-layer context only. Set true to veto
# extreme divergence. Do not force-enable on live.
SENTIMENT_FILTER_ENABLED=false

# Signal Weighting (Sum must be 1.0)
WEIGHT_TECHNICAL=0.50
WEIGHT_SENTIMENT=0.25
WEIGHT_MACRO=0.25

# Kelly Criterion sizing (Advanced)
USE_KELLY=true               # Use TradeJournal stats for sizing if available

# Volatility protection
# Reduce position size by 50% if VIX is above this level
VIX_THRESHOLD=25.0

# Safety overrides for testing (set to true to disable drawdown and other risk limits)
DISABLE_RISK_GUARD=false


# ── API access control (REQUIRED in live mode) ────────────────────────────────
# POST/PUT/DELETE on /trading/* and all /api-keys /storage routes require
# Authorization: Bearer <token> or X-API-Key: <token>. GET /trading/* stays open.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
# External agent tool connections (MCP, Cursor agents, GrokBOT overseer)
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
AGENT_API_KEY=
# Required by the production compose file; protects Qdrant even on localhost.
QDRANT_API_KEY=
# Internal OpenSearch (n8n community node). Loopback only — see opensearch/docker-compose.yml
OPENSEARCH_URL=http://ai-trading-opensearch:9200
# Explicit acknowledgement required by hostinger_vps_apply.sh when both
# PAPER_TRADING=false and DRY_RUN_ALL=false.
CONFIRM_LIVE_DEPLOY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081


# ── Monitoring & Automation ───────────────────────────────────────────────────

# InfluxDB (For Grafana Dashboards)
INFLUXDB_URL=http://vps-influxdb:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=hedge-fund
INFLUXDB_BUCKET=trading-system
INFLUXDB_ADMIN_PASSWORD=change-me-strong-password
GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin

# n8n Webhook (Send every signal/order to your automation flows)
N8N_WEBHOOK_URL=

# Telegram Bot (Real-time trade alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry watchdog. Paper/backtest: auto-resume defaults ON.
# Live cash: defaults OFF. Both SENTRY_AUTO_RESUME_ENABLED=true AND
# SENTRY_AUTO_RESUME_LIVE_CONFIRM=I_UNDERSTAND are required. A stray
# SENTRY_AUTO_RESUME_ENABLED=true on live money is not enough.
SENTRY_AUTO_RESUME_ENABLED=true
SENTRY_AUTO_RESUME_LIVE_CONFIRM=
SENTRY_RESUME_AFTER_SEC=120
SENTRY_RESUME_HEALTH_CHECKS=6

# Logging
LOG_LEVEL=INFO


# ── Symbol Overrides ───────────────────────────────────────────────────────────

# Comma-separated lists to override default MarketConfigs
# TRADE_SYMBOLS_CRYPTO=BTC/USDT,ETH/USDT,SOL/USDT
# TRADE_SYMBOLS_FOREX=EURUSD,GBPUSD,USDJPY
# TRADE_SYMBOLS_STOCKS=NVDA,AAPL,TSLA

# ── Live trading symbol list (drives trading_loop) ─────────────────────────────
# MiCA/EEA: USDT is restricted for EU users — trade USDC-margined perpetuals so
# the account's USDC balance is usable margin. DOT has no USDC perp (dropped).
# This is also defaulted in docker-compose; set here to override.
TRADING_SYMBOLS=BTCUSDC,ETHUSDC,SOLUSDC,BNBUSDC,XRPUSDC,AVAXUSDC,LINKUSDC,UNIUSDC

# ── Symbol-Quality Gate (liquidity filter + blacklist) ─────────────────────────
# Reject any symbol whose Binance Futures 24h quote volume (USDT) is below this
# floor. Low-liquidity / new-listing meme symbols produced the entire realized
# loss tail (~-$300 over 81 days) via wide spreads, slippage and forced
# liquidations. Set 0 to disable the volume gate.
# NOTE: USDC perp books are far thinner than their USDT twins (UNIUSDC ~$3.8M,
# LINKUSDC ~$8.8M, AVAXUSDC ~$10M vs $50M+ on USDT). A 50M floor
# silently drops several USDC majors. 3M keeps blue-chip USDC perps
# while still excluding illiquid meme/new-listing pairs (the real loss-tail).
MIN_24H_QUOTE_VOLUME_USDT=3000000
# Hard blacklist — skipped for NEW entries (open legs still managed).
# Includes meme/illiquid losers plus Jul-2026 weekly loss leaders ADA/ARB/DOGE/APT.
SYMBOL_BLACKLIST=ADAUSDT,ARBUSDT,DOGEUSDT,APTUSDT,ADAUSDC,ARBUSDC,DOGEUSDC,APTUSDC,SIRENUSDT,AIGENSYNUSDT,INUSDT,BUSDT,BRUSDT,SPKUSDT,MAGMAUSDT,VELVETUSDT,HOMEUSDT,BTWUSDT,LABUSDT

# ── Risk halts (do NOT set these to 99/100 in production) ──────────────────────
# Rolling portfolio drawdown and UTC daily-loss gates. Disabled only when >=100.
RISK_MAX_DRAWDOWN_PCT=20
RISK_MAX_DAILY_LOSS_PCT=5
# Peak equity lookback for drawdown % (hours). Prefer a recent window after a
# large realized drawdown so the 20% gate protects forward instead of locking
# the loop against an old all-time/30d peak.
RISK_PEAK_LOOKBACK_HOURS=72
MAX_SAME_DIRECTION_POSITIONS=8
PYRAMID_MODE=false
PYRAMID_MAX_LAYERS=2
PYRAMID_BLOCK_UNDERWATER=true

# ── Recovery / green-day mode (optional) ──────────────────────────────────────
# After a losing week, apply on the VPS with:
#   ./scripts/vps_apply_recovery_mode.sh
# That script sets majors-only symbols, PYRAMID_MODE=false, MAX_POSITIONS=3,
# MIN_SIGNAL_STRENGTH=0.60, RISK_PER_TRADE_PCT=0.005, RISK_MAX_DAILY_LOSS_PCT=2,
# and closes blacklisted open legs (e.g. DOGE).
#
# To allow more concurrent seats on recent positive-edge symbols:
#   ./scripts/vps_apply_quality_expand.sh
# (BTC/ETH/SOL/BNB/NEAR/LTC/LINK, MAX_POSITIONS=6, min signal 0.55, daily halt 3%)

# ── Min-Edge Gate (fee-churn killer) ───────────────────────────────────────────
# 81-day live history: 52% of trades were scratches (|PnL| <= $0.20) and total
# commission drag was -$193.54 on a +$64 net. A trade is only taken if its gross
# expected move to TP clears MIN_EDGE_FEE_MULT x the round-trip cost
# (2*(taker_fee + slippage) of notional). At the defaults below the TP must clear
# a ~0.30% move — well under normal ATR-driven TPs, but it kills tight scratch
# entries that can never out-earn their own fees. Set MIN_EDGE_FEE_MULT=0 to disable.
TAKER_FEE_RATE=0.0004
SLIPPAGE_RATE=0.0002
MIN_EDGE_FEE_MULT=2.5

# ── Trailing stop (ratchet-only, ATR-based) ──
# Fixes trades that run into profit then round-trip all the way back to the
# original SL (the "oscillating between SL and TP" problem). Once a position
# has moved TRAIL_ACTIVATION_ATR x ATR into profit, the stop follows the
# high-water mark by TRAIL_ATR_MULT x ATR and ONLY ever tightens (never
# loosens). The trailed level is written into the trade's stop_loss, so the
# existing SL/TP close path enforces it every 5-min cycle — no extra exchange
# order to desync. Set TRAILING_STOP_ENABLED=false to disable.
TRAILING_STOP_ENABLED=true
# Activate near the 2.5 ATR TP so winners can run; early BE (STEP_TRAIL) is off.
TRAIL_ACTIVATION_ATR=2.0
# TRAIL_ATR_MULT must be < TRAIL_ACTIVATION_ATR. At 0.8 (vs activation 2.0) the
# trail locks ~+1.2 ATR once armed.
TRAIL_ATR_MULT=0.8
STEP_TRAIL_ENABLED=false

# ── Maker (post-only) entries — fee-churn fix ──
# Historical fills were 100% TAKER (0.05%), the single largest account drain
# (~38%/mo in commission). When enabled, ENTRIES are placed as post-only (GTX)
# LIMIT orders at the near touch (maker, 0.02% or rebate). If unfilled within
# MAKER_WAIT_SEC, the order is cancelled and falls back to a MARKET order, so
# behavior degrades safely to today's taker path. Closes/SL/TP stay MARKET.
# ON by default to cut commission bleed; set false to force taker entries.
MAKER_ENTRY_ENABLED=true
MAKER_WAIT_SEC=30

# ── SL/TP geometry (ATR multiples, env-tunable) ──
# Canonical QTP house lock — training Triple-Barrier labels MUST match these.
# Initial stop = entry -/+ SL_ATR_MULT x ATR; take-profit = entry +/- TP_ATR_MULT
# x ATR. TP_ATR_MULT is the home-run cap; the trailing stop banks the realistic
# winners before price gets there. Keep TP/SL ratio >= the min-edge multiple.
# Models trained on any other pair are rejected by the promotion gate.
SL_ATR_MULT=1.75
TP_ATR_MULT=5.5
ATR_PERIOD=14

# ── Trade Timing & Pre-Execution Gating ──
# In-memory candle ring buffer depth (per symbol and interval)
CANDLE_CACHE_SIZE=500

# Kronos sidecar microservice URL (PyTorch CPU execution)
KRONOS_SIDECAR_URL=http://kronos-infer:8001
# Host-published sidecar port (compose maps 127.0.0.1:8002 -> container 8001)
KRONOS_LOCAL_URL=http://127.0.0.1:8002
# Fail-closed when sidecar is down (do NOT enable in live trading)
KRONOS_ALLOW_LOCAL_STUB=false
# Sidecar-only: allow analytical stub if NeoQuasar weights fail to load
KRONOS_ALLOW_ANALYTICAL_FALLBACK=false

# Kronos pre-execution veto thresholds (5-bar return & max adverse excursion)
KRONOS_VETO_CUM5_PCT=1.2
KRONOS_VETO_MAE_PCT=2.0

# Pre-Execution Gate Shadow Mode (false = enforce gate in production; true = shadow/log only)
TIMING_GATE_SHADOW=false

# Heuristic Timing Guard risk score threshold (0.0 safe to 1.0 extreme risk)
TIMING_GUARD_RISK_THRESHOLD=0.65

# Optional Vision LLM timing verification (secondary veto for large positions)
ENABLE_VISION_TIMING=false
VISION_MIN_NOTIONAL=500.0

# ── Safe Product Background Defaults ──
# Explicit background toggles to prevent API rate-limit burns or accidental live overrides
SKILL_MINER_ENABLED=false
SCRAPLING_INGEST_ENABLED=false
FEED_SCHEDULER_ENABLED=true
TRADE_MEMORY_ENABLED=true
FINMEM_ENABLED=false
JESSE_SYNC_TO_LIVE=false
# Jesse dashboard password (no hardcoded fallback in the bridge)
JESSE_PASSWORD=
# Allow serving ML artifacts that fail DSR/PBO/geometry gates (default: refuse)
JESSE_ML_ALLOW_OVERFIT=false
# When LightGBM is quarantined/missing, retry Jesse /predict with this type (ETH/SOL LSTM).
# Set none|false|off to disable fallback (live will no_model veto on missing primary).
JESSE_ML_FALLBACK_MODEL_TYPE=lstm
# Live policy when Jesse has no model: skip (allow strategy) or veto (block entries).
JESSE_ML_NO_MODEL_POLICY=skip
# Jesse /predict HTTP timeout (CPU LSTM cold-start needs >5s; default 20, max 30).
JESSE_ML_PREDICT_TIMEOUT=20

# ── QTP Promotion Contract v1.0.0 ──
# GPU job writes geometry.json + metrics.json here. Decision Engine re-reads
# hashes and walks gates; it never recomputes DSR/PBO. Unset = legacy ML path.
# QTP_PROMOTION_ARTIFACT_DIR=
# QTP_HOLDOUT_REGISTRY_PATH=
# QTP_PROMOTION_REQUIRED=false

# ── Research Plane (OpenSearch, SearXNG, MT Bridge) ──
# Dedicated research plane on trading-net; fail-soft, read-only to trading loop
OPENSEARCH_URL=http://opensearch:9200
SEARXNG_URL=http://searxng:8080
MT5_BRIDGE_URL=http://mt5-bridge:8001
RESEARCH_INGEST_ENABLED=false
RESEARCH_SEARXNG_INTERVAL_SEC=900
RESEARCH_SENTIMENT_ENABLED=false
RESEARCH_SENTIMENT_TIMEOUT_SEC=10.0


