FROM python:3.14-slim

WORKDIR /app

# Install system deps + curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster Python builds
RUN pip install --no-cache-dir uv

# Copy dependency manifests
COPY backend/requirements.txt .
COPY pyproject.toml .
COPY poetry.lock .

# Install with uv (uses wheels where possible, faster than pip)
RUN uv pip install --system --no-cache -r requirements.txt \
    && uv pip install --system --no-cache ctrader-open-api==0.9.2 --no-deps

# Copy application code
COPY backend/ ./backend/
COPY scripts/ ./scripts/
COPY scrapling_sidecar/ ./scrapling_sidecar/
COPY README.md .

# Create data dirs
RUN mkdir -p /app/data /app/logs

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Single worker for trading bot state consistency (in-memory locks, cooldowns, loops)
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
