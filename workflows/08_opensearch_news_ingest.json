{
  "name": "08 - OpenSearch News Ingest (15m)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "os-ingest-cron",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://ai-trading-backend:8000/api/news/feed",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "limit", "value": "40" }]
        },
        "options": {}
      },
      "id": "os-ingest-http",
      "name": "HTTP: News Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "resource": "index",
        "operation": "create",
        "indexId": "qt-news",
        "additionalFields": {
          "skipIfExists": true
        }
      },
      "id": "os-ingest-index",
      "name": "Ensure qt-news Index",
      "type": "n8n-nodes-opensearch.opensearch",
      "typeVersion": 1,
      "position": [680, 180],
      "continueOnFail": true,
      "credentials": {
        "openSearchApi": {
          "id": "XppZPpbkZfdbJ9oO",
          "name": "OpenSearch account"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "os-ingest-split",
      "name": "Split Articles",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 420]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "title",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "summary",
              "name": "summary",
              "value": "={{ $json.summary }}",
              "type": "string"
            },
            {
              "id": "url",
              "name": "url",
              "value": "={{ $json.url }}",
              "type": "string"
            },
            {
              "id": "source",
              "name": "source",
              "value": "={{ $json.source }}",
              "type": "string"
            },
            {
              "id": "published",
              "name": "published",
              "value": "={{ $json.published }}",
              "type": "string"
            },
            {
              "id": "sentiment",
              "name": "sentiment",
              "value": "={{ $json.sentiment }}",
              "type": "string"
            },
            {
              "id": "ingested_at",
              "name": "ingested_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "os-ingest-map",
      "name": "Normalize Article",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 420]
    },
    {
      "parameters": {
        "resource": "document",
        "operation": "create",
        "indexId": "qt-news",
        "dataToSend": "autoMapInputData",
        "inputsToIgnore": "",
        "additionalFields": {
          "documentId": "={{ $json.url }}"
        },
        "options": {
          "bulkOperation": true,
          "refresh": "false"
        }
      },
      "id": "os-ingest-index-doc",
      "name": "Index Article",
      "type": "n8n-nodes-opensearch.opensearch",
      "typeVersion": 1,
      "position": [1160, 420],
      "continueOnFail": true,
      "credentials": {
        "openSearchApi": {
          "id": "XppZPpbkZfdbJ9oO",
          "name": "OpenSearch account"
        }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "HTTP: News Feed", "type": "main", "index": 0 }]]
    },
    "HTTP: News Feed": {
      "main": [
        [
          { "node": "Ensure qt-news Index", "type": "main", "index": 0 },
          { "node": "Split Articles", "type": "main", "index": 0 }
        ]
      ]
    },
    "Split Articles": {
      "main": [[{ "node": "Normalize Article", "type": "main", "index": 0 }]]
    },
    "Normalize Article": {
      "main": [[{ "node": "Index Article", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
