    },
    "Search Params": {
      "main": [[{ "node": "OpenSearch Hybrid-ish Search", "type": "main", "index": 0 }]]
    },
    "OpenSearch Hybrid-ish Search": {
      "main": [[{ "node": "From Webhook?", "type": "main", "index": 0 }]]
    },
    "From Webhook?": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }],
        [{ "node": "Manual Done", "type": "main", "index": 0 }]
